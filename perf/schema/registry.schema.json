{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unframed.local/perf/schema/registry.schema.json",
  "title": "Workload registry",
  "type": "object",
  "required": ["version", "workloads"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "target"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {"enum": ["http", "browser"]},
          "target": {
            "type": "string",
            "description": "http: absolute loopback URL. browser: route path or loopback URL."
          },
          "rate": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "http only: requests per second."
          },
          "duration": {
            "type": "string",
            "description": "http only: Go duration syntax, e.g. \"10s\"."
          },
          "repetitions": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "browser only: page-load repetitions."
          }
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "http"}}},
            "then": {
              "required": ["rate", "duration"],
              "not": {"required": ["repetitions"]}
            }
          },
          {
            "if": {"properties": {"kind": {"const": "browser"}}},
            "then": {
              "required": ["repetitions"],
              "not": {"anyOf": [{"required": ["rate"]}, {"required": ["duration"]}]}
            }
          }
        ]
      }
    }
  }
}
