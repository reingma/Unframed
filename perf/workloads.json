{
  "version": 2,
  "workloads": [
    {
      "id": "backend-healthcheck",
      "kind": "http",
      "target": "http://127.0.0.1:8080/healthcheck",
      "rate": 50,
      "duration": "10s"
    },
    {
      "id": "backend-manifest",
      "kind": "http",
      "target": "http://127.0.0.1:8080/manifest",
      "rate": 50,
      "duration": "10s"
    },
    {
      "id": "backend-article",
      "kind": "http",
      "target": "http://127.0.0.1:8080/articles/essays/hello-world",
      "rate": 50,
      "duration": "10s"
    },
    {
      "id": "backend-not-found",
      "kind": "http",
      "target": "http://127.0.0.1:8080/articles/essays/missing",
      "rate": 50,
      "duration": "10s",
      "status": 404
    },
    {
      "id": "backend-manifest-large",
      "kind": "http",
      "target": "http://127.0.0.1:8081/manifest",
      "rate": 50,
      "duration": "10s"
    },
    {
      "id": "backend-article-large",
      "kind": "http",
      "target": "http://127.0.0.1:8081/articles/section-10/article-25",
      "rate": 50,
      "duration": "10s"
    },
    {
      "id": "frontend-root",
      "kind": "browser",
      "target": "/",
      "repetitions": 50
    },
    {
      "id": "frontend-article",
      "kind": "browser",
      "target": "/essays/hello-world",
      "repetitions": 50
    },
    {
      "id": "frontend-listing",
      "kind": "browser",
      "target": "/essays",
      "repetitions": 50
    },
    {
      "id": "frontend-bundle",
      "kind": "build",
      "target": "frontend/.next"
    }
  ]
}
